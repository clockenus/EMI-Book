{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/clockenus/EMI-Book",
        "sources": "https://github.com/clockenus/EMI-Book"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.clocken.emibook.EMIBook"
        ],
        "client": [
            "com.clocken.emibook.EMIBookClient"
        ],
        "modmenu": [
            "com.clocken.emibook.integration.ModMenuIntegration"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "emi": ">=${emi_version}"
    },
    "suggests": {
        "cloth_config": ">=${cloth_config_version}",
        "mod_menu": ">=${mod_menu_version}"
    }
}
  